# Default: let git detect text vs. binary, force LF on commit + checkout for text files.
* text=auto eol=lf

*.md      text eol=lf
*.php     text eol=lf
*.js      text eol=lf
*.css     text eol=lf
*.yml     text eol=lf
*.json    text eol=lf
*.sh      text eol=lf

*.png     binary
*.jpg     binary
*.gif     binary

# Keep development-only paths out of the source archive.
/tests/         export-ignore
/docs/          export-ignore
/tools/         export-ignore
/.github/       export-ignore
/.gitattributes export-ignore
/.gitignore     export-ignore
/package.json   export-ignore
/package-lock.json export-ignore
